load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@gazelle//:def.bzl", "gazelle")
load("@rules_pkg//pkg/private/tar:tar.bzl", "pkg_tar")
load("@tar.bzl", "tar")

filegroup(
    name = "compilation-db",
    srcs = ["compile_commands.json"],
    visibility = ["//visibility:public"],
)

buildifier(
    name = "buildifier",
    lint_mode = "fix",
    mode = "fix",
)

gazelle(name = "gazelle")

genrule(
    name = "clang_format",
    srcs = ["@llvm_toolchain//:bin/clang-format"],
    outs = ["clang-format"],
    cmd = "cat $< > $@",
    executable = True,
)

# save a file into a .tar archive
pkg_tar(
    name = "archive",
    srcs = ["//:LICENSE"],
    # Use an "epoch" time for the modification time
    # of each file inside the archive.
    stamp = 0,
)

tar(
    name = "archive-lean",
    srcs = ["//:LICENSE"],
)

# to access by a `py_binary` target under `data`
exports_files(["adhoc/data.json"])

genrule(
    name = "save-the-date-genrule",
    srcs = ["@dates_repo_rule//:now.json"],
    outs = ["now-copied.json"],
    # https://bazel.build/reference/be/make-variables#predefined_genrule_variables
    cmd = "cp $(SRCS) $@",
    tags = ["manual"],
)

genrule(
    name = "message_pb_genrule",
    srcs = [
        "@protoc_prebuilt//:bin/protoc",
        "pbs/message.proto",
    ],
    outs = ["pbs/message_pb2.py"],
    # https://bazel.build/reference/be/make-variables#predefined_genrule_variables
    cmd = """
      mkdir -p $(RULEDIR)/pbs && \
      $(location @protoc_prebuilt//:bin/protoc) \
        --python_out=$(RULEDIR) \
        $(location pbs/message.proto)
    """,
    visibility = ["//visibility:public"],
)
